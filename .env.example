# Copy to .env for local docker-compose use. Never commit real values.

# App
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT (min 32 bytes, base64 recommended)
JWT_SECRET=change-me-to-a-long-random-base64-string

# Database
DB_URL=jdbc:postgresql://db:5432/virtualpetdb
DB_USER=virtualpet
DB_PASSWORD=change-me
DB_DRIVER=org.postgresql.Driver
DB_NAME=virtualpetdb
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# CORS
CORS_ORIGINS=http://3.144.149.124,http://18.226.20.103,http://localhost:3000,http://localhost:3001
